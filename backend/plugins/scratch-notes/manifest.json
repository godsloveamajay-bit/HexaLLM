{
  "name": "scratch-notes",
  "version": "1.0.0",
  "description": "Read and write short notes in a sandbox-scoped scratch directory. Demonstrates filesystem permissions.",
  "author": "HexaLLM",
  "license": "MIT",
  "entry_point": "plugin.py",
  "isolation": "sandbox",
  "permissions": {
    "filesystem": [
      "scratch"
    ],
    "network": [],
    "secrets": [],
    "subprocess": false
  },
  "rate_limit": {
    "per_user": 20,
    "per_plugin": 60,
    "period_seconds": 60
  },
  "tools": [
    {
      "name": "note_write",
      "description": "Save a note. Input: JSON {\"name\": \"my-note\", \"text\": \"...\"}. Only the sandbox scratch directory is writable.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Note name (letters, digits, - and _)"
          },
          "text": {
            "type": "string"
          }
        },
        "required": [
          "name",
          "text"
        ]
      }
    },
    {
      "name": "note_read",
      "description": "Read a saved note by name.",
      "input_schema": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ]
      }
    },
    {
      "name": "note_list",
      "description": "List saved notes."
    }
  ],
  "budget": {
    "per_day_calls": 500,
    "max_daily_cost_usd": 0.0,
    "max_output_bytes": 16384,
    "max_latency_ms": 15000
  },
  "retention_days": 30
}
