[Unit]
Description=HexaLLM backend (FastAPI/uvicorn)
After=network-online.target ollama.service nginx.service hexallm-vllm.service
Wants=hexallm-vllm.service
Wants=ollama.service nginx.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/HexaLLM/backend
# Per-model GPU layer budget for ollama (CPU-RAM offload): the 14B gets
# 12/41 layers on GPU (~3.3GB) so it stays resident alongside vLLM.
Environment="OLLAMA_NUM_GPU_OFFLOAD={\"qwen3:14b\": 12}"
ExecStart=/root/HexaLLM/backend/venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Environment=HOME=/root
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target