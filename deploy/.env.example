# Secrets for the prod stack — copy to /home/hexallm/HexaLLM/.env
#   cp deploy/.env.example .env
# Required (the stack refuses to start without them):
#   POSTGRES_PASSWORD — the db password; generate with `openssl rand -hex 20`
#   SECRET_KEY        — JWT signing key; generate with `openssl rand -hex 32`
POSTGRES_PASSWORD=
SECRET_KEY=
APP_URL=https://ai.hexallm.co.uk

# Optional — enables the GHCR pull path in deploy.sh (CI-pushed images).
# Create a PAT at github.com/settings/tokens with `read:packages` scope.
GHCR_USER=godsloveamajay-bit
GHCR_PAT=

# ── Optional platform integrations (compose forwards these to the backend) ──
DEBUG=false
STABILITY_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
SAMSUNG_CLIENT_ID=
SAMSUNG_CLIENT_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@hexallm.local
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX=true